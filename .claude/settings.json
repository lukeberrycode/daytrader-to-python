{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync)",
      "Bash(uv run ruff *)",
      "Bash(uv run pytest *)",
      "Bash(scripts/wait-for-legacy.sh)",
      "Bash(docker build -t daytrader8-legacy *)",
      "Bash(docker logs legacy)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(legacy/daytrader8/**)",
      "Bash(gh pr merge *)",
      "Bash(git push --force *)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": ["docker *", "scripts/wait-for-legacy.sh", "uv run pytest tests/characterisation*"],
    "network": {
      "allowedDomains": ["pypi.org", "files.pythonhosted.org", "github.com", "api.github.com", "localhost"]
    }
  }
}
